        <mxCell id="8BfTQBOIwbfhKneN2qXS-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;1qdp5fz&quot; data-start=&quot;14255&quot; data-end=&quot;14298&quot;&gt;Demo 4: AI-Driven Incident Response &amp;amp; RCA&lt;/h1&gt;&#xa;&lt;h2 data-section-id=&quot;151jjl6&quot; data-start=&quot;14300&quot; data-end=&quot;14312&quot;&gt;Objective&lt;/h2&gt;&#xa;&lt;p data-start=&quot;14314&quot; data-end=&quot;14410&quot;&gt;Show how AI can convert logs, metrics, and deployment history into a structured incident report.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;14412&quot; data-end=&quot;14415&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;1jut2m5&quot; data-start=&quot;14417&quot; data-end=&quot;14437&quot;&gt;Incident Scenario&lt;/h2&gt;&#xa;&lt;p data-start=&quot;14439&quot; data-end=&quot;14493&quot;&gt;Payments failed for 12 minutes after a new deployment.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;14495&quot; data-end=&quot;14498&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;101nvqb&quot; data-start=&quot;14500&quot; data-end=&quot;14516&quot;&gt;Incident Data&lt;/h2&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;14518&quot; data-end=&quot;15196&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Incident Time:&lt;/span&gt;&lt;br&gt;&lt;span&gt;10:05 AM to 10:17 AM IST&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Impact:&lt;/span&gt;&lt;br&gt;&lt;span&gt;9% payment failures&lt;/span&gt;&lt;br&gt;&lt;span&gt;p95 latency increased from 350ms to 4200ms&lt;/span&gt;&lt;br&gt;&lt;span&gt;Partial payment processing delays&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Recent Deployment:&lt;/span&gt;&lt;br&gt;&lt;span&gt;payment-service:v1.8.4 deployed at 09:58 AM IST&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Change:&lt;/span&gt;&lt;br&gt;&lt;span&gt;New ledger query introduced for duplicate payment validation.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Key Logs:&lt;/span&gt;&lt;br&gt;&lt;span&gt;10:05 WARN DB connection wait time high waitMs=1800&lt;/span&gt;&lt;br&gt;&lt;span&gt;10:06 ERROR HikariPool-1 - Connection is not available&lt;/span&gt;&lt;br&gt;&lt;span&gt;10:08 ERROR Payment failed error=DB_CONNECTION_TIMEOUT&lt;/span&gt;&lt;br&gt;&lt;span&gt;10:12 WARN p99 latency crossed 7000ms&lt;/span&gt;&lt;br&gt;&lt;span&gt;10:17 INFO Rollback completed to payment-service:v1.8.3&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Metrics:&lt;/span&gt;&lt;br&gt;&lt;span&gt;db_connection_active=50/50&lt;/span&gt;&lt;br&gt;&lt;span&gt;db_connection_pending_threads=38&lt;/span&gt;&lt;br&gt;&lt;span&gt;cpu_usage=62%&lt;/span&gt;&lt;br&gt;&lt;span&gt;memory_usage=71%&lt;/span&gt;&lt;br&gt;&lt;span&gt;error_rate=9%&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;" vertex="1">
