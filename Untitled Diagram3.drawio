        </mxCell>
        <mxCell id="euAPPqePTSpbdA661mlb-4" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=20;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Point&lt;/th&gt;&lt;th&gt;Virtual Machine&lt;/th&gt;&lt;th&gt;Container&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Runs on&lt;/td&gt;&lt;td&gt;Hypervisor&lt;/td&gt;&lt;td&gt;Container Runtime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Includes OS?&lt;/td&gt;&lt;td&gt;Yes, full guest OS&lt;/td&gt;&lt;td&gt;No full OS, shares host OS kernel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Startup time&lt;/td&gt;&lt;td&gt;Slow, usually minutes&lt;/td&gt;&lt;td&gt;Fast, usually seconds&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Size&lt;/td&gt;&lt;td&gt;GBs&lt;/td&gt;&lt;td&gt;MBs or small GBs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Isolation&lt;/td&gt;&lt;td&gt;Stronger&lt;/td&gt;&lt;td&gt;Lightweight isolation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Performance&lt;/td&gt;&lt;td&gt;Slightly heavier&lt;/td&gt;&lt;td&gt;Faster and lightweight&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Example tools&lt;/td&gt;&lt;td&gt;VMware, VirtualBox, Hyper-V, KVM&lt;/td&gt;&lt;td&gt;Docker, containerd, Podman&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Best for&lt;/td&gt;&lt;td&gt;Full OS-level isolation&lt;/td&gt;&lt;td&gt;App packaging and deployment&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="230" y="700" as="geometry" />
        </mxCell>
