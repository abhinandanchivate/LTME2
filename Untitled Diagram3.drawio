        <mxCell id="gJ9fQJMAkEa3Ao8VECqi-8" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=22;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Situation&lt;/th&gt;&lt;th&gt;Severity&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;10% payments failing globally&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;p95 latency increased from 300ms to 5 seconds&lt;/td&gt;&lt;td&gt;P2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;One PSP provider is slow but fallback works&lt;/td&gt;&lt;td&gt;P3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CPU is 75% during sale but payments are successful&lt;/td&gt;&lt;td&gt;P4 / Warning&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
