        <mxCell id="8BfTQBOIwbfhKneN2qXS-6" parent="1" style="text;whiteSpace=wrap;" value="┌───────────────┐&#xa;                    │ Checkout Code │&#xa;                    └───────┬───────┘&#xa;                            │&#xa;        ┌───────────────────┼───────────────────┐&#xa;        │                   │                   │&#xa;┌──────────────┐   ┌──────────────────┐   ┌──────────────┐&#xa;│ Unit Tests   │   │ Integration Test │   │ Code Quality │&#xa;└──────┬───────┘   └────────┬─────────┘   └──────┬───────┘&#xa;       │                    │                    │&#xa;       └────────────────────┼────────────────────┘&#xa;                            │&#xa;                    ┌───────▼───────┐&#xa;                    │ Build Package │&#xa;                    └───────┬───────┘&#xa;                            │&#xa;                    ┌───────▼───────┐&#xa;                    │ Docker Build  │&#xa;                    └───────┬───────┘&#xa;                            │&#xa;                    ┌───────▼───────┐&#xa;                    │ Deploy        │&#xa;                    └───────────────┘" vertex="1">
