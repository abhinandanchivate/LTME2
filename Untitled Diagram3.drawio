  <diagram id="deIovMyNFVJAwo_Lf7f-" name="Page-7">
    <mxGraphModel dx="658" dy="441" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="8BfTQBOIwbfhKneN2qXS-1" parent="1" style="text;whiteSpace=wrap;fontSize=17;" value="Root Cause:&#xa;A retry configuration change caused repeated payment status checks.&#xa;&#xa;&#xa;Evidence:&#xa;1. Retry count increased from 3 to 10.&#xa;2. API traffic increased 4x.&#xa;3. Database connection pool reached 100%.&#xa;4. Payment API latency increased from 300 ms to 4 seconds.&#xa;5. Checkout failures started after deployment v2.3.1.&#xa;&#xa;&#xa;Recommended Fix:&#xa;Reduce retry count, add exponential backoff, and increase DB connection pool size." vertex="1">
          <mxGeometry height="230" width="480" x="100" y="90" as="geometry" />
        </mxCell>
        <mxCell id="8BfTQBOIwbfhKneN2qXS-2" parent="1" style="text;whiteSpace=wrap;" value="1. CPU crosses 80%&#xa;2. Alert is triggered&#xa;3. Engineer checks logs manually&#xa;4. Engineer checks Grafana manually&#xa;5. Engineer checks database manually&#xa;6. Engineer checks recent deployment manually&#xa;7. Root cause is found after 1-2 hours&#xa;8. Manual rollback or fix is done" vertex="1">
          <mxGeometry height="140" width="290" x="460" y="690" as="geometry" />
        </mxCell>
        <mxCell id="8BfTQBOIwbfhKneN2qXS-3" parent="1" style="text;whiteSpace=wrap;" value="1. AI detects abnormal latency before CPU reaches critical level&#xa;2. AI correlates logs, metrics, traces, and deployment history&#xa;3. AI identifies payment-api v2.3.1 as the likely trigger&#xa;4. AI finds DB connection timeout errors increased after deployment&#xa;5. AI suggests rollback or config correction&#xa;6. AI generates incident summary and RCA&#xa;7. Team resolves issue faster" vertex="1">
          <mxGeometry height="120" width="390" x="390" y="880" as="geometry" />
        </mxCell>
        <mxCell id="8BfTQBOIwbfhKneN2qXS-4" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h1 data-section-id=&quot;um9dmi&quot; data-start=&quot;154&quot; data-end=&quot;219&quot;&gt;AI-Assisted CI/CD + Testing + Observability + RCA Demonstration&lt;/h1&gt;&#xa;&lt;h2 data-section-id=&quot;139rdrr&quot; data-start=&quot;221&quot; data-end=&quot;234&quot;&gt;Demo Theme&lt;/h2&gt;&#xa;&lt;p data-start=&quot;236&quot; data-end=&quot;446&quot;&gt;&lt;strong data-start=&quot;236&quot; data-end=&quot;252&quot;&gt;Application:&lt;/strong&gt; Payments Service&lt;br data-start=&quot;269&quot; data-end=&quot;272&quot;&gt;&#xa;&lt;strong data-start=&quot;272&quot; data-end=&quot;287&quot;&gt;Tech Stack:&lt;/strong&gt; Spring Boot, Maven, PostgreSQL, Redis, Kafka, Docker, GitHub Actions or GitLab CI, Kubernetes/EKS, CloudWatch/Prometheus/Grafana, OpenTelemetry, AI assistant.&lt;/p&gt;&#xa;&lt;h2 data-section-id=&quot;ca88h9&quot; data-start=&quot;448&quot; data-end=&quot;468&quot;&gt;Business Scenario&lt;/h2&gt;&#xa;&lt;p data-start=&quot;470&quot; data-end=&quot;548&quot;&gt;A Payments microservice is deployed using CI/CD. Recently, the team is facing:&lt;/p&gt;&#xa;&lt;ol data-start=&quot;550&quot; data-end=&quot;704&quot;&gt;&#xa;&lt;li data-section-id=&quot;1qmu3n&quot; data-start=&quot;550&quot; data-end=&quot;577&quot;&gt;&#xa;Slow pipeline execution.&#xa;&lt;/li&gt;&#xa;&lt;li data-section-id=&quot;1epxrxb&quot; data-start=&quot;578&quot; data-end=&quot;608&quot;&gt;&#xa;Random/flaky test failures.&#xa;&lt;/li&gt;&#xa;&lt;li data-section-id=&quot;e0wz6y&quot; data-start=&quot;609&quot; data-end=&quot;638&quot;&gt;&#xa;Production latency spikes.&#xa;&lt;/li&gt;&#xa;&lt;li data-section-id=&quot;11nje4&quot; data-start=&quot;639&quot; data-end=&quot;704&quot;&gt;&#xa;One payment outage due to database connection pool exhaustion.&#xa;&lt;/li&gt;&#xa;&lt;/ol&gt;&#xa;&lt;p data-start=&quot;706&quot; data-end=&quot;747&quot;&gt;The goal is to show how AI can assist in:&lt;/p&gt;&#xa;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;749&quot; data-end=&quot;1051&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;749&quot; data-end=&quot;771&quot;&gt;&lt;tr data-start=&quot;749&quot; data-end=&quot;771&quot;&gt;&lt;th data-start=&quot;749&quot; data-end=&quot;756&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Area&lt;/th&gt;&lt;th data-start=&quot;756&quot; data-end=&quot;771&quot; data-col-size=&quot;md&quot; class=&quot;last:pe-10&quot;&gt;Demo Output&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;782&quot; data-end=&quot;1051&quot;&gt;&lt;tr data-start=&quot;782&quot; data-end=&quot;840&quot;&gt;&lt;td data-start=&quot;782&quot; data-end=&quot;803&quot; data-col-size=&quot;sm&quot;&gt;CI/CD Optimization&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;803&quot; data-end=&quot;840&quot;&gt;Faster and more reliable pipeline&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;841&quot; data-end=&quot;904&quot;&gt;&lt;td data-start=&quot;841&quot; data-end=&quot;865&quot; data-col-size=&quot;sm&quot;&gt;Test Failure Analysis&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;865&quot; data-end=&quot;904&quot;&gt;Identify flaky tests and root cause&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;905&quot; data-end=&quot;979&quot;&gt;&lt;td data-start=&quot;905&quot; data-end=&quot;938&quot; data-col-size=&quot;sm&quot;&gt;Log &amp;amp; Metric Anomaly Detection&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;938&quot; data-end=&quot;979&quot;&gt;Detect abnormal latency/error pattern&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;980&quot; data-end=&quot;1051&quot;&gt;&lt;td data-start=&quot;980&quot; data-end=&quot;1006&quot; data-col-size=&quot;sm&quot;&gt;Incident Response &amp;amp; RCA&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1006&quot; data-end=&quot;1051&quot;&gt;Generate incident summary and post-mortem&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="780" width="560" x="320" y="980" as="geometry" />
        </mxCell>
        <UserObject label="name: payments-ci&#xa;&#xa;&#xa;on:&#xa;  push:&#xa;    branches:&#xa;      - main&#xa;&#xa;&#xa;jobs:&#xa;  build-test-deploy:&#xa;    runs-on: ubuntu-latest&#xa;&#xa;&#xa;    steps:&#xa;      - name: Checkout Code&#xa;        uses: actions/checkout@v4&#xa;&#xa;&#xa;      - name: Set up Java&#xa;        uses: actions/setup-java@v4&#xa;        with:&#xa;          java-version: &#39;17&#39;&#xa;          distribution: &#39;temurin&#39;&#xa;&#xa;&#xa;      - name: Maven Clean Package&#xa;        run: mvn clean package&#xa;&#xa;&#xa;      - name: Build Docker Image&#xa;        run: docker build -t payment-service:${{ github.sha }} .&#xa;&#xa;&#xa;      - name: Deploy to Kubernetes&#xa;        run: kubectl apply -f k8s/" link="name: payments-ci&#xa;&#xa;&#xa;on:&#xa;  push:&#xa;    branches:&#xa;      - main&#xa;&#xa;&#xa;jobs:&#xa;  build-test-deploy:&#xa;    runs-on: ubuntu-latest&#xa;&#xa;&#xa;    steps:&#xa;      - name: Checkout Code&#xa;        uses: actions/checkout@v4&#xa;&#xa;&#xa;      - name: Set up Java&#xa;        uses: actions/setup-java@v4&#xa;        with:&#xa;          java-version: &#39;17&#39;&#xa;          distribution: &#39;temurin&#39;&#xa;&#xa;&#xa;      - name: Maven Clean Package&#xa;        run: mvn clean package&#xa;&#xa;&#xa;      - name: Build Docker Image&#xa;        run: docker build -t payment-service:${{ github.sha }} .&#xa;&#xa;&#xa;      - name: Deploy to Kubernetes&#xa;        run: kubectl apply -f k8s/" id="8BfTQBOIwbfhKneN2qXS-5">
