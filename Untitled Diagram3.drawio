        <mxCell id="gJ9fQJMAkEa3Ao8VECqi-6" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=25;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Area&lt;/th&gt;&lt;th&gt;Meaning&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;What to monitor&lt;/td&gt;&lt;td&gt;Payment success rate, latency, errors, DB pool, Kafka lag&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Threshold&lt;/td&gt;&lt;td&gt;When should alert fire?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Duration&lt;/td&gt;&lt;td&gt;How long should the problem continue before alerting?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Severity&lt;/td&gt;&lt;td&gt;P1, P2, P3, P4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Notification&lt;/td&gt;&lt;td&gt;Slack, PagerDuty, email, SMS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Owner&lt;/td&gt;&lt;td&gt;Payment SRE, Backend team, DBA, Platform team&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Runbook&lt;/td&gt;&lt;td&gt;What steps to follow after alert fires&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
