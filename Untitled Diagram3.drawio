        <mxCell id="gJ9fQJMAkEa3Ao8VECqi-7" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=20;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Field&lt;/th&gt;&lt;th&gt;Example&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Service&lt;/td&gt;&lt;td&gt;payment-service&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SLI&lt;/td&gt;&lt;td&gt;Payment Success Rate&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Alert condition&lt;/td&gt;&lt;td&gt;Payment failure rate &amp;gt; 2%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Duration&lt;/td&gt;&lt;td&gt;For 5 minutes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Severity&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Impact&lt;/td&gt;&lt;td&gt;Customers may not be able to complete payments&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Notification&lt;/td&gt;&lt;td&gt;PagerDuty + Slack + Incident channel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Owner&lt;/td&gt;&lt;td&gt;Payment SRE team&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Runbook&lt;/td&gt;&lt;td&gt;Check recent deployment, DB pool, PSP status, logs, rollback option&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
