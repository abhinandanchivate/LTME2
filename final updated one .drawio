        <UserObject label="PUT _index_template/logs-app-template&#xa;{&#xa;  &quot;index_patterns&quot;: [&quot;logs-*&quot;],&#xa;  &quot;data_stream&quot;: {},&#xa;  &quot;template&quot;: {&#xa;    &quot;settings&quot;: {&#xa;      &quot;index.lifecycle.name&quot;: &quot;logs-30-days-policy&quot;,&#xa;      &quot;index.number_of_shards&quot;: 1,&#xa;      &quot;index.number_of_replicas&quot;: 1,&#xa;      &quot;index.refresh_interval&quot;: &quot;5s&quot;&#xa;    },&#xa;    &quot;mappings&quot;: {&#xa;      &quot;properties&quot;: {&#xa;        &quot;@timestamp&quot;: {&#xa;          &quot;type&quot;: &quot;date&quot;&#xa;        },&#xa;        &quot;service&quot;: {&#xa;          &quot;type&quot;: &quot;keyword&quot;&#xa;        },&#xa;        &quot;environment&quot;: {&#xa;          &quot;type&quot;: &quot;keyword&quot;&#xa;        },&#xa;        &quot;level&quot;: {&#xa;          &quot;type&quot;: &quot;keyword&quot;&#xa;        },&#xa;        &quot;traceId&quot;: {&#xa;          &quot;type&quot;: &quot;keyword&quot;&#xa;        },&#xa;        &quot;spanId&quot;: {&#xa;          &quot;type&quot;: &quot;keyword&quot;&#xa;        },&#xa;        &quot;orderId&quot;: {&#xa;          &quot;type&quot;: &quot;keyword&quot;&#xa;        },&#xa;        &quot;message&quot;: {&#xa;          &quot;type&quot;: &quot;text&quot;&#xa;        },&#xa;        &quot;latencyMs&quot;: {&#xa;          &quot;type&quot;: &quot;long&quot;&#xa;        }&#xa;      }&#xa;    }&#xa;  },&#xa;  &quot;priority&quot;: 500&#xa;}" link="PUT _index_template/logs-app-template&#xa;{&#xa;  &quot;index_patterns&quot;: [&quot;logs-*&quot;],&#xa;  &quot;data_stream&quot;: {},&#xa;  &quot;template&quot;: {&#xa;    &quot;settings&quot;: {&#xa;      &quot;index.lifecycle.name&quot;: &quot;logs-30-days-policy&quot;,&#xa;      &quot;index.number_of_shards&quot;: 1,&#xa;      &quot;index.number_of_replicas&quot;: 1,&#xa;      &quot;index.refresh_interval&quot;: &quot;5s&quot;&#xa;    },&#xa;    &quot;mappings&