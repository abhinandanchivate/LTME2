        <mxCell id="KMrnfizv_kjCtf4Co5FG-12" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;div&gt;input {&lt;/div&gt;&lt;div&gt;&amp;nbsp; tcp {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; port =&amp;gt; 5000&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; codec =&amp;gt; json_lines&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;filter {&lt;/div&gt;&lt;div&gt;&amp;nbsp; mutate {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; add_field =&amp;gt; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;log_source&quot; =&amp;gt; &quot;spring-boot-direct&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; if [level] == &quot;ERROR&quot; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; mutate {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; add_field =&amp;gt; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;alert_required&quot; =&amp;gt; &quot;true&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;output {&lt;/div&gt;&lt;div&gt;&amp;nbsp; elasticsearch {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; hosts =&amp;gt; [&quot;http://elasticsearch:9200&quot;]&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; index =&amp;gt; &quot;springboot-direct-logs-%{+YYYY.MM.dd}&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; stdout {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; codec =&amp;gt; rubydebug&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="720" width="330" x="1480" y="1970" as="geometry" />
        </mxCell>
