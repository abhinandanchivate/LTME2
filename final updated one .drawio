        <UserObject label="@Test&#xa;void shouldCreatePaymentAndPublishEvent() {&#xa;    PaymentRequest request = new PaymentRequest(&#xa;            &quot;TXN-1001&quot;,&#xa;            BigDecimal.valueOf(500),&#xa;            &quot;INR&quot;&#xa;    );&#xa;&#xa;&#xa;    PaymentResponse response = paymentService.createPayment(request);&#xa;&#xa;&#xa;    PaymentEvent event = kafkaTestConsumer.getLastEvent();&#xa;&#xa;&#xa;    assertEquals(&quot;SUCCESS&quot;, response.status());&#xa;    assertEquals(&quot;SUCCESS&quot;, event.status());&#xa;}" link="@Test&#xa;void shouldCreatePaymentAndPublishEvent() {&#xa;    PaymentRequest request = new PaymentRequest(&#xa;            &quot;TXN-1001&quot;,&#xa;            BigDecimal.valueOf(500),&#xa;            &quot;INR&quot;&#xa;    );&#xa;&#xa;&#xa;    PaymentResponse response = paymentService.createPayment(request);&#xa;&#xa;&#xa;    PaymentEvent event = kafkaTestConsumer.getLastEvent();&#xa;&#xa;&#xa;    assertEquals(&quot;SUCCESS&quot;, response.status());&#xa;    assertEquals(&quot;SUCCESS&quot;, event.status());&#xa;}" id="8BfTQBOIwbfhKneN2qXS-7">
          <mxCell parent="1" style="text;whiteSpace=wrap;" vertex="1">
