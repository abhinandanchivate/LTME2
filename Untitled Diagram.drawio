        <UserObject label="package com.bank.payment.service;&#xa;&#xa;&#xa;import com.bank.payment.dto.PaymentResponse;&#xa;import org.springframework.retry.annotation.Backoff;&#xa;import org.springframework.retry.annotation.Recover;&#xa;import org.springframework.retry.annotation.Retryable;&#xa;import org.springframework.stereotype.Service;&#xa;&#xa;&#xa;@Service&#xa;public class RedisCacheRetryService {&#xa;&#xa;&#xa;    private final IdempotencyService idempotencyService;&#xa;&#xa;&#xa;    public RedisCacheRetryService(IdempotencyService idempotencyService) {&#xa;        this.idempotencyService = idempotencyService;&#xa;    }&#xa;&#xa;&#xa;    @Retryable(&#xa;            retryFor = RuntimeException.class,&#xa;            maxAttempts = 3,&#xa;            backoff = @Backoff(delay = 200, multiplier = 2)&#xa;    )&#xa;    public void saveFinalResponseWithRetry(&#xa;            String idempotencyKey,&#xa;            PaymentResponse response&#xa;    ) {&#xa;        idempotencyService.saveFinalResponse(idempotencyKey, response);&#xa;    }&#xa;&#xa;&#xa;    @Recover&#xa;    public void recover(&#xa;            RuntimeException exception,&#xa;            String idempotencyKey,&#xa;            PaymentResponse response&#xa;    ) {&#xa;        /*&#xa;         * Called after all retry attempts fail.&#xa;         * Do not throw error if payment is already saved in DB.&#xa;         */&#xa;        System.err.println(&#xa;                &quot;Redis cache update failed after retries. key=&quot;&#xa;                        + idempotencyKey&#xa;                        + &quot;, error=&quot;&#xa;                        + exception.getMessage()&#xa;        );&#xa;    }&#xa;}" link="package com.bank.payment.service;&#xa;&#xa;&#xa;import com.bank.payment.dto.PaymentResponse;&#xa;import org.springframework.retry.annotation.Backoff;&#xa;import org.springframework.retry.annotation.Recover;&#xa;import org.springframework.retry.annotation.Retryable;&#xa;import org.springframework.stereotype.Service;&#xa;&#xa;&#xa;@Service&#xa;public class RedisCacheRetryService {&#xa;&#xa;&#xa;    private final IdempotencyService idempotencyService;&#xa;&#xa;&#xa;    public RedisCacheRetryService(IdempotencyService idempotencyService) {&#xa;        this.idempotencyService = idempotencyService;&#xa;    }&#xa;&#xa;&#xa;    @Retryable(&#xa;            retryFor = RuntimeException.class,&#xa;            maxAttempts = 3,&#xa;            backoff = @Backoff(delay = 200, multiplier = 2)&#xa;    )&#xa;    public void saveFinalResponseWithRetry(&#xa;            String idempotencyKey,&#xa;            PaymentResponse response&#xa;    ) {&#xa;        idempotencyService.saveFinalResponse(idempotencyKey, response);&#xa;    }&#xa;&#xa;&#xa;    @Recover&#xa;    public void recover(&#xa;            RuntimeException exception,&#xa;            String idempotencyKey,&#xa;            PaymentResponse response&#xa;    ) {&#xa;        /*&#xa;         * Called after all retry attempts fail.&#xa;         * Do not throw error if payment is already saved in DB.&#xa;         */&#xa;        System.err.println(&#xa;                &quot;Redis cache update failed after retries. key=&quot;&#xa;                        + idempotencyKey&#xa;                        + &quot;, error=&quot;&#xa;                        + exception.getMessage()&#xa;        );&#xa;    }&#xa;}" id="2ISZ2FkVQAoQxKfAu9j2-1">
