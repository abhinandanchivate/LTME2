        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-23" edge="1" parent="1" source="jweHISguANsyJ_0BMwG7-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="jweHISguANsyJ_0BMwG7-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-21" parent="1" style="text;whiteSpace=wrap;" value="Total IPs = 256&#xa;AWS reserved IPs = 5&#xa;Usable IPs = 256 - 5 = 251" vertex="1">
          <mxGeometry height="70" width="180" x="2390" y="5280" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-25" edge="1" parent="1" source="jweHISguANsyJ_0BMwG7-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="jweHISguANsyJ_0BMwG7-24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-22" parent="1" style="whiteSpace=wrap;html=1;" value="1. netwrok address&lt;div&gt;2. broadcast address&lt;/div&gt;&lt;div&gt;3. future&amp;nbsp;&lt;/div&gt;&lt;div&gt;4. VPC router&lt;/div&gt;&lt;div&gt;5. DNS&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="140" x="2410" y="5430" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-27" edge="1" parent="1" source="jweHISguANsyJ_0BMwG7-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="jweHISguANsyJ_0BMwG7-26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-24" parent="1" style="whiteSpace=wrap;html=1;" value="192.168.1.0/24" vertex="1">
          <mxGeometry height="60" width="120" x="2420" y="5667.5" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-26" parent="1" style="whiteSpace=wrap;html=1;" value="&lt;meta charset=&quot;utf-8&quot;&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;IP Address&lt;/th&gt;&lt;th&gt;Reserved For&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;192.168.1.0&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Network address&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;192.168.1.1&lt;/code&gt;&lt;/td&gt;&lt;td&gt;AWS VPC router&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;192.168.1.2&lt;/code&gt;&lt;/td&gt;&lt;td&gt;AWS DNS server&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;192.168.1.3&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Reserved by AWS for future use&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;192.168.1.255&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Broadcast address&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="202.5" width="330" x="2315" y="5770" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-28" parent="1" style="text;whiteSpace=wrap;" value="STATEFUL_RULE_GROUP_ARN=$(aws network-firewall create-rule-group \&#xa;  --rule-group-name hub-stateful-rulegroup \&#xa;  --type STATEFUL \&#xa;  --capacity 100 \&#xa;  --rule-group &#39;{&#xa;    &quot;RulesSource&quot;: {&#xa;      &quot;StatefulRules&quot;: [&#xa;        {&#xa;          &quot;Action&quot;: &quot;PASS&quot;,&#xa;          &quot;Header&quot;: {&#xa;            &quot;Protocol&quot;: &quot;TCP&quot;,&#xa;            &quot;Source&quot;: &quot;10.0.0.0/8&quot;,&#xa;            &quot;SourcePort&quot;: &quot;ANY&quot;,&#xa;            &quot;Direction&quot;: &quot;FORWARD&quot;,&#xa;            &quot;Destination&quot;: &quot;ANY&quot;,&#xa;            &quot;DestinationPort&quot;: &quot;443&quot;&#xa;          },&#xa;          &quot;RuleOptions&quot;: [&#xa;            {&#xa;              &quot;Keyword&quot;: &quot;sid&quot;,&#xa;              &quot;Settings&quot;: [&quot;1&quot;]&#xa;            }&#xa;          ]&#xa;        }&#xa;      ]&#xa;    }&#xa;  }&#39; \&#xa;  --region $AWS_REGION \&#xa;  --query RuleGroupResponse.RuleGroupArn \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;Stateful Rule Group ARN: $STATEFUL_RULE_GROUP_ARN&quot;" vertex="1">
          <mxGeometry height="500" width="440" x="2410" y="6350" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-29" parent="1" style="text;whiteSpace=wrap;" value="FW_POLICY_ARN=$(aws network-firewall create-firewall-policy \&#xa;  --firewall-policy-name hub-fw-policy \&#xa;  --firewall-policy &quot;{&#xa;    \&quot;StatelessDefaultActions\&quot;: [\&quot;aws:forward_to_sfe\&quot;],&#xa;    \&quot;StatelessFragmentDefaultActions\&quot;: [\&quot;aws:forward_to_sfe\&quot;],&#xa;    \&quot;StatefulRuleGroupReferences\&quot;: [&#xa;      {&#xa;        \&quot;ResourceArn\&quot;: \&quot;$STATEFUL_RULE_GROUP_ARN\&quot;&#xa;      }&#xa;    ]&#xa;  }&quot; \&#xa;  --region $AWS_REGION \&#xa;  --query FirewallPolicyResponse.FirewallPolicyArn \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;Firewall Policy ARN: $FW_POLICY_ARN&quot;" vertex="1">
          <mxGeometry height="270" width="380" x="2360" y="6880" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-30" parent="1" style="text;whiteSpace=wrap;fontSize=16;" value="# Public route table → IGW&#xa;PUB_RT=$(aws ec2 create-route-table --vpc-id $HUB_VPC \&#xa;  --tag-specifications &#39;ResourceType=route-table,Tags=[{Key=Name,Value=hub-public-rt}]&#39; \&#xa;  --query RouteTable.RouteTableId --output text)&#xa;aws ec2 associate-route-table --route-table-id $PUB_RT --subnet-id $HUB_PUB&#xa;aws ec2 create-route --route-table-id $PUB_RT \&#xa;  --destination-cidr-block 0.0.0.0/0 --gateway-id $HUB_IGW&#xa;&#xa;&#xa;# Firewall route table → NAT for egress, TGW for spoke traffic&#xa;FW_RT=$(aws ec2 create-route-table --vpc-id $HUB_VPC \&#xa;  --tag-specifications &#39;ResourceType=route-table,Tags=[{Key=Name,Value=hub-firewall-rt}]&#39; \&#xa;  --query RouteTable.RouteTableId --output text)&#xa;aws ec2 associate-route-table --route-table-id $FW_RT --subnet-id $HUB_FW_SUB&#xa;aws ec2 create-route --route-table-id $FW_RT \&#xa;  --destination-cidr-block 0.0.0.0/0 --nat-gateway-id $NAT_GW&#xa;aws ec2 create-route --route-table-id $FW_RT \&#xa;  --destination-cidr-block 10.0.0.0/8 --transit-gateway-id $TGW&#xa;&#xa;&#xa;# TGW route table → firewall endpoint (get endpoint ID after firewall is active)&#xa;TGW_RT=$(aws ec2 create-route-table --vpc-id $HUB_VPC \&#xa;  --tag-specifications &#39;ResourceType=route-table,Tags=[{Key=Name,Value=hub-tgw-rt}]&#39; \&#xa;  --query RouteTable.RouteTableId --output text)&#xa;aws ec2 associate-route-table --route-table-id $TGW_RT --subnet-id $HUB_TGW_SUB&#xa;# Add firewall endpoint route once firewall is READY:&#xa;# aws ec2 create-route --route-table-id $TGW_RT \&#xa;#   --destination-cidr-block 0.0.0.0/0 --vpc-endpoint-id &lt;FIREWALL_ENDPOINT_ID&gt;" vertex="1">
          <mxGeometry height="460" width="550" x="2470" y="7330" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-31" parent="1" style="text;whiteSpace=wrap;fontSize=19;" value="# Spoke 1 VPC&#xa;SP1_VPC=$(aws ec2 create-vpc --cidr-block 10.1.0.0/16 \&#xa;  --tag-specifications &#39;ResourceType=vpc,Tags=[{Key=Name,Value=spoke1-payment-vpc}]&#39; \&#xa;  --query Vpc.VpcId --output text)&#xa;&#xa;&#xa;SP1_PUB=$(aws ec2 create-subnet --vpc-id $SP1_VPC \&#xa;  --cidr-block 10.1.1.0/24 --availability-zone ${AWS_REGION}a \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke1-public}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;SP1_APP=$(aws ec2 create-subnet --vpc-id $SP1_VPC \&#xa;  --cidr-block 10.1.2.0/24 --availability-zone ${AWS_REGION}a \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke1-app}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;SP1_DB=$(aws ec2 create-subnet --vpc-id $SP1_VPC \&#xa;  --cidr-block 10.1.3.0/24 --availability-zone ${AWS_REGION}b \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke1-db}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;# Attach Spoke 1 to TGW&#xa;SP1_ATTACH=$(aws ec2 create-transit-gateway-vpc-attachment \&#xa;  --transit-gateway-id $TGW \&#xa;  --vpc-id $SP1_VPC \&#xa;  --subnet-ids $SP1_APP \&#xa;  --tag-specifications &#39;ResourceType=transit-gateway-attachment,Tags=[{Key=Name,Value=spoke1-payment-attach}]&#39; \&#xa;  --query TransitGatewayVpcAttachment.TransitGatewayAttachmentId --output text)&#xa;&#xa;&#xa;# Route table for Spoke 1 private subnets → TGW for all traffic&#xa;SP1_RT=$(aws ec2 create-route-table --vpc-id $SP1_VPC \&#xa;  --tag-specifications &#39;ResourceType=route-table,Tags=[{Key=Name,Value=spoke1-private-rt}]&#39; \&#xa;  --query RouteTable.RouteTableId --output text)&#xa;aws ec2 associate-route-table --route-table-id $SP1_RT --subnet-id $SP1_APP&#xa;aws ec2 associate-route-table --route-table-id $SP1_RT --subnet-id $SP1_DB&#xa;aws ec2 create-route --route-table-id $SP1_RT \&#xa;  --destination-cidr-block 0.0.0.0/0 --transit-gateway-id $TGW" vertex="1">
          <mxGeometry height="1220" width="580" x="2500" y="8080" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-32" parent="1" style="text;whiteSpace=wrap;fontSize=19;" value="export AWS_REGION=us-east-1&#xa;&#xa;&#xa;# Spoke 1 VPC&#xa;SP1_VPC=$(aws ec2 create-vpc \&#xa;  --cidr-block 10.1.0.0/16 \&#xa;  --region $AWS_REGION \&#xa;  --tag-specifications &#39;ResourceType=vpc,Tags=[{Key=Name,Value=spoke1-payment-vpc}]&#39; \&#xa;  --query Vpc.VpcId \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;SP1_VPC=$SP1_VPC&quot;&#xa;&#xa;&#xa;# Enable DNS support&#xa;aws ec2 modify-vpc-attribute \&#xa;  --vpc-id $SP1_VPC \&#xa;  --enable-dns-support &quot;{\&quot;Value\&quot;:true}&quot; \&#xa;  --region $AWS_REGION&#xa;&#xa;&#xa;aws ec2 modify-vpc-attribute \&#xa;  --vpc-id $SP1_VPC \&#xa;  --enable-dns-hostnames &quot;{\&quot;Value\&quot;:true}&quot; \&#xa;  --region $AWS_REGION&#xa;&#xa;&#xa;# Public subnet - AZ a&#xa;SP1_PUB=$(aws ec2 create-subnet \&#xa;  --vpc-id $SP1_VPC \&#xa;  --cidr-block 10.1.1.0/24 \&#xa;  --availability-zone ${AWS_REGION}a \&#xa;  --region $AWS_REGION \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke1-public}]&#39; \&#xa;  --query Subnet.SubnetId \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;SP1_PUB=$SP1_PUB&quot;&#xa;&#xa;&#xa;# App subnet - AZ a&#xa;SP1_APP=$(aws ec2 create-subnet \&#xa;  --vpc-id $SP1_VPC \&#xa;  --cidr-block 10.1.2.0/24 \&#xa;  --availability-zone ${AWS_REGION}a \&#xa;  --region $AWS_REGION \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke1-app}]&#39; \&#xa;  --query Subnet.SubnetId \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;SP1_APP=$SP1_APP&quot;&#xa;&#xa;&#xa;# DB subnet - AZ b&#xa;SP1_DB=$(aws ec2 create-subnet \&#xa;  --vpc-id $SP1_VPC \&#xa;  --cidr-block 10.1.3.0/24 \&#xa;  --availability-zone ${AWS_REGION}b \&#xa;  --region $AWS_REGION \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke1-db}]&#39; \&#xa;  --query Subnet.SubnetId \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;SP1_DB=$SP1_DB&quot;&#xa;&#xa;&#xa;# Attach Spoke 1 to TGW&#xa;# Better: attach one subnet from each AZ where workloads exist.&#xa;# Here APP is in us-east-1a and DB is in us-east-1b.&#xa;SP1_ATTACH=$(aws ec2 create-transit-gateway-vpc-attachment \&#xa;  --transit-gateway-id $TGW \&#xa;  --vpc-id $SP1_VPC \&#xa;  --subnet-ids $SP1_APP $SP1_DB \&#xa;  --region $AWS_REGION \&#xa;  --tag-specifications &#39;ResourceType=transit-gateway-attachment,Tags=[{Key=Name,Value=spoke1-payment-attach}]&#39; \&#xa;  --query TransitGatewayVpcAttachment.TransitGatewayAttachmentId \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;SP1_ATTACH=$SP1_ATTACH&quot;&#xa;&#xa;&#xa;# Wait until TGW attachment becomes available&#xa;aws ec2 wait transit-gateway-vpc-attachment-available \&#xa;  --transit-gateway-attachment-ids $SP1_ATTACH \&#xa;  --region $AWS_REGION&#xa;&#xa;&#xa;echo &quot;TGW attachment is available&quot;&#xa;&#xa;&#xa;# Route table for Spoke 1 private subnets&#xa;SP1_RT=$(aws ec2 create-route-table \&#xa;  --vpc-id $SP1_VPC \&#xa;  --region $AWS_REGION \&#xa;  --tag-specifications &#39;ResourceType=route-table,Tags=[{Key=Name,Value=spoke1-private-rt}]&#39; \&#xa;  --query RouteTable.RouteTableId \&#xa;  --output text)&#xa;&#xa;&#xa;echo &quot;SP1_RT=$SP1_RT&quot;&#xa;&#xa;&#xa;# Associate route table with private subnets&#xa;aws ec2 associate-route-table \&#xa;  --route-table-id $SP1_RT \&#xa;  --subnet-id $SP1_APP \&#xa;  --region $AWS_REGION&#xa;&#xa;&#xa;aws ec2 associate-route-table \&#xa;  --route-table-id $SP1_RT \&#xa;  --subnet-id $SP1_DB \&#xa;  --region $AWS_REGION&#xa;&#xa;&#xa;# Route private subnet traffic to TGW&#xa;aws ec2 create-route \&#xa;  --route-table-id $SP1_RT \&#xa;  --destination-cidr-block 0.0.0.0/0 \&#xa;  --transit-gateway-id $TGW \&#xa;  --region $AWS_REGION" vertex="1">
          <mxGeometry height="1850" width="560" x="2580" y="9410" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="iFWkrODPjHI0oakj6ao9" name="Page-10">
    <mxGraphModel dx="658" dy="441" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="# Create EKS cluster IAM role first&#xa;aws iam create-role --role-name EKSClusterRole \&#xa;  --assume-role-policy-document &#39;{&#xa;    &quot;Version&quot;:&quot;2012-10-17&quot;,&#xa;    &quot;Statement&quot;:[{&quot;Effect&quot;:&quot;Allow&quot;,&quot;Principal&quot;:{&quot;Service&quot;:&quot;eks.amazonaws.com&quot;},&quot;Action&quot;:&quot;sts:AssumeRole&quot;}]&#xa;  }&#39;&#xa;aws iam attach-role-policy --role-name EKSClusterRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEKSClusterPolicy&#xa;&#xa;&#xa;# Create EKS cluster&#xa;aws eks create-cluster \&#xa;  --name payment-eks \&#xa;  --role-arn arn:aws:iam::${ACCOUNT_ID}:role/EKSClusterRole \&#xa;  --resources-vpc-config subnetIds=$SP1_APP,$SP1_DB,endpointPublicAccess=false,endpointPrivateAccess=true&#xa;&#xa;&#xa;# Wait for cluster&#xa;aws eks wait cluster-active --name payment-eks&#xa;&#xa;&#xa;# Node group role&#xa;aws iam create-role --role-name EKSNodeRole \&#xa;  --assume-role-policy-document &#39;{&#xa;    &quot;Version&quot;:&quot;2012-10-17&quot;,&#xa;    &quot;Statement&quot;:[{&quot;Effect&quot;:&quot;Allow&quot;,&quot;Principal&quot;:{&quot;Service&quot;:&quot;ec2.amazonaws.com&quot;},&quot;Action&quot;:&quot;sts:AssumeRole&quot;}]&#xa;  }&#39;&#xa;aws iam attach-role-policy --role-name EKSNodeRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy&#xa;aws iam attach-role-policy --role-name EKSNodeRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy&#xa;aws iam attach-role-policy --role-name EKSNodeRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly&#xa;&#xa;&#xa;# Add node group&#xa;aws eks create-nodegroup \&#xa;  --cluster-name payment-eks \&#xa;  --nodegroup-name payment-nodes \&#xa;  --node-role arn:aws:iam::${ACCOUNT_ID}:role/EKSNodeRole \&#xa;  --subnets $SP1_APP \&#xa;  --instance-types t3.medium \&#xa;  --scaling-config minSize=2,maxSize=4,desiredSize=2" link="# Create EKS cluster IAM role first&#xa;aws iam create-role --role-name EKSClusterRole \&#xa;  --assume-role-policy-document &#39;{&#xa;    &quot;Version&quot;:&quot;2012-10-17&quot;,&#xa;    &quot;Statement&quot;:[{&quot;Effect&quot;:&quot;Allow&quot;,&quot;Principal&quot;:{&quot;Service&quot;:&quot;eks.amazonaws.com&quot;},&quot;Action&quot;:&quot;sts:AssumeRole&quot;}]&#xa;  }&#39;&#xa;aws iam attach-role-policy --role-name EKSClusterRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEKSClusterPolicy&#xa;&#xa;&#xa;# Create EKS cluster&#xa;aws eks create-cluster \&#xa;  --name payment-eks \&#xa;  --role-arn arn:aws:iam::${ACCOUNT_ID}:role/EKSClusterRole \&#xa;  --resources-vpc-config subnetIds=$SP1_APP,$SP1_DB,endpointPublicAccess=false,endpointPrivateAccess=true&#xa;&#xa;&#xa;# Wait for cluster&#xa;aws eks wait cluster-active --name payment-eks&#xa;&#xa;&#xa;# Node group role&#xa;aws iam create-role --role-name EKSNodeRole \&#xa;  --assume-role-policy-document &#39;{&#xa;    &quot;Version&quot;:&quot;2012-10-17&quot;,&#xa;    &quot;Statement&quot;:[{&quot;Effect&quot;:&quot;Allow&quot;,&quot;Principal&quot;:{&quot;Service&quot;:&quot;ec2.amazonaws.com&quot;},&quot;Action&quot;:&quot;sts:AssumeRole&quot;}]&#xa;  }&#39;&#xa;aws iam attach-role-policy --role-name EKSNodeRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy&#xa;aws iam attach-role-policy --role-name EKSNodeRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy&#xa;aws iam attach-role-policy --role-name EKSNodeRole \&#xa;  --policy-arn arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly&#xa;&#xa;&#xa;# Add node group&#xa;aws eks create-nodegroup \&#xa;  --cluster-name payment-eks \&#xa;  --nodegroup-name payment-nodes \&#xa;  --node-role arn:aws:iam::${ACCOUNT_ID}:role/EKSNodeRole \&#xa;  --subnets $SP1_APP \&#xa;  --instance-types t3.medium \&#xa;  --scaling-config minSize=2,maxSize=4,desiredSize=2" id="-IuRlMxD6YqI_Nr9y-Qa-1">
          <mxCell parent="1" style="text;whiteSpace=wrap;fontSize=20;" vertex="1">
            <mxGeometry height="690" width="560" x="240" y="90" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="aws rds create-db-subnet-group \&#xa;  --db-subnet-group-name spoke1-db-subnet-group \&#xa;  --db-subnet-group-description &quot;Spoke 1 DB subnets&quot; \&#xa;  --subnet-ids $SP1_DB&#xa;&#xa;&#xa;DB_SG=$(aws ec2 create-security-group \&#xa;  --group-name spoke1-db-sg --description &quot;Spoke1 DB SG&quot; \&#xa;  --vpc-id $SP1_VPC --query GroupId --output text)&#xa;aws ec2 authorize-security-group-ingress --group-id $DB_SG \&#xa;  --protocol tcp --port 5432 --cidr 10.1.2.0/24&#xa;&#xa;&#xa;aws rds create-db-instance \&#xa;  --db-instance-identifier payment-db \&#xa;  --db-instance-class db.r6g.large \&#xa;  --engine postgres --engine-version 15.4 \&#xa;  --master-username paymentadmin \&#xa;  --master-user-password YOUR_STRONG_PASSWORD \&#xa;  --db-subnet-group-name spoke1-db-subnet-group \&#xa;  --vpc-security-group-ids $DB_SG \&#xa;  --multi-az \&#xa;  --storage-encrypted \&#xa;  --no-publicly-accessible \&#xa;  --deletion-protection \&#xa;  --backup-retention-period 7 \&#xa;  --tags Key=Name,Value=payment-db" link="aws rds create-db-subnet-group \&#xa;  --db-subnet-group-name spoke1-db-subnet-group \&#xa;  --db-subnet-group-description &quot;Spoke 1 DB subnets&quot; \&#xa;  --subnet-ids $SP1_DB&#xa;&#xa;&#xa;DB_SG=$(aws ec2 create-security-group \&#xa;  --group-name spoke1-db-sg --description &quot;Spoke1 DB SG&quot; \&#xa;  --vpc-id $SP1_VPC --query GroupId --output text)&#xa;aws ec2 authorize-security-group-ingress --group-id $DB_SG \&#xa;  --protocol tcp --port 5432 --cidr 10.1.2.0/24&#xa;&#xa;&#xa;aws rds create-db-instance \&#xa;  --db-instance-identifier payment-db \&#xa;  --db-instance-class db.r6g.large \&#xa;  --engine postgres --engine-version 15.4 \&#xa;  --master-username paymentadmin \&#xa;  --master-user-password YOUR_STRONG_PASSWORD \&#xa;  --db-subnet-group-name spoke1-db-subnet-group \&#xa;  --vpc-security-group-ids $DB_SG \&#xa;  --multi-az \&#xa;  --storage-encrypted \&#xa;  --no-publicly-accessible \&#xa;  --deletion-protection \&#xa;  --backup-retention-period 7 \&#xa;  --tags Key=Name,Value=payment-db" id="-IuRlMxD6YqI_Nr9y-Qa-2">
          <mxCell parent="1" style="text;whiteSpace=wrap;fontSize=21;" vertex="1">
            <mxGeometry height="410" width="590" x="220" y="1560" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SP2_VPC=$(aws ec2 create-vpc --cidr-block 10.2.0.0/16 \&#xa;  --tag-specifications &#39;ResourceType=vpc,Tags=[{Key=Name,Value=spoke2-reporting-vpc}]&#39; \&#xa;  --query Vpc.VpcId --output text)&#xa;&#xa;&#xa;SP2_APP=$(aws ec2 create-subnet --vpc-id $SP2_VPC \&#xa;  --cidr-block 10.2.1.0/24 --availability-zone ${AWS_REGION}a \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke2-app}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;SP2_DB=$(aws ec2 create-subnet --vpc-id $SP2_VPC \&#xa;  --cidr-block 10.2.2.0/24 --availability-zone ${AWS_REGION}b \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke2-db}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;aws ec2 create-transit-gateway-vpc-attachment \&#xa;  --transit-gateway-id $TGW \&#xa;  --vpc-id $SP2_VPC \&#xa;  --subnet-ids $SP2_APP \&#xa;  --tag-specifications &#39;ResourceType=transit-gateway-attachment,Tags=[{Key=Name,Value=spoke2-reporting-attach}]&#39;&#xa;&#xa;&#xa;# Reporting DB (Redshift)&#xa;aws redshift create-cluster \&#xa;  --cluster-identifier reporting-warehouse \&#xa;  --node-type ra3.xlplus \&#xa;  --number-of-nodes 2 \&#xa;  --master-username reportadmin \&#xa;  --master-user-password YOUR_STRONG_PASSWORD \&#xa;  --encrypted \&#xa;  --tags Key=Name,Value=reporting-warehouse" link="SP2_VPC=$(aws ec2 create-vpc --cidr-block 10.2.0.0/16 \&#xa;  --tag-specifications &#39;ResourceType=vpc,Tags=[{Key=Name,Value=spoke2-reporting-vpc}]&#39; \&#xa;  --query Vpc.VpcId --output text)&#xa;&#xa;&#xa;SP2_APP=$(aws ec2 create-subnet --vpc-id $SP2_VPC \&#xa;  --cidr-block 10.2.1.0/24 --availability-zone ${AWS_REGION}a \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke2-app}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;SP2_DB=$(aws ec2 create-subnet --vpc-id $SP2_VPC \&#xa;  --cidr-block 10.2.2.0/24 --availability-zone ${AWS_REGION}b \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke2-db}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;aws ec2 create-transit-gateway-vpc-attachment \&#xa;  --transit-gateway-id $TGW \&#xa;  --vpc-id $SP2_VPC \&#xa;  --subnet-ids $SP2_APP \&#xa;  --tag-specifications &#39;ResourceType=transit-gateway-attachment,Tags=[{Key=Name,Value=spoke2-reporting-attach}]&#39;&#xa;&#xa;&#xa;# Reporting DB (Redshift)&#xa;aws redshift create-cluster \&#xa;  --cluster-identifier reporting-warehouse \&#xa;  --node-type ra3.xlplus \&#xa;  --number-of-nodes 2 \&#xa;  --master-username reportadmin \&#xa;  --master-user-password YOUR_STRONG_PASSWORD \&#xa;  --encrypted \&#xa;  --tags Key=Name,Value=reporting-warehouse" id="-IuRlMxD6YqI_Nr9y-Qa-3">
          <mxCell parent="1" style="text;whiteSpace=wrap;fontSize=19;" vertex="1">
            <mxGeometry height="510" width="560" x="380" y="2530" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="oNRsaX6cdKYoyba7iWuk" name="Page-11">
    <mxGraphModel dx="658" dy="441" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Emtq0ach0h8BXGZ76xUH-1" parent="1" style="text;whiteSpace=wrap;" value="SP3_VPC=$(aws ec2 create-vpc --cidr-block 10.3.0.0/16 \&#xa;  --tag-specifications &#39;ResourceType=vpc,Tags=[{Key=Name,Value=spoke3-shared-vpc}]&#39; \&#xa;  --query Vpc.VpcId --output text)&#xa;&#xa;&#xa;SP3_APP=$(aws ec2 create-subnet --vpc-id $SP3_VPC \&#xa;  --cidr-block 10.3.1.0/24 --availability-zone ${AWS_REGION}a \&#xa;  --tag-specifications &#39;ResourceType=subnet,Tags=[{Key=Name,Value=spoke3-app}]&#39; \&#xa;  --query Subnet.SubnetId --output text)&#xa;&#xa;&#xa;aws ec2 create-transit-gateway-vpc-attachment \&#xa;  --transit-gateway-id $TGW \&#xa;  --vpc-id $SP3_VPC \&#xa;  --subnet-ids $SP3_APP \&#xa;  --tag-specifications &#39;ResourceType=transit-gateway-attachment,Tags=[{Key=Name,Value=spoke3-shared-attach}]&#39;" vertex="1">
          <mxGeometry height="270" width="560" x="140" y="180" as="geometry" />
        </mxCell>
        <mxCell id="hPt8dpyRI3YwL0fGorsx-1" parent="1" style="text;whiteSpace=wrap;" value="# CloudWatch Log Groups&#xa;aws logs create-log-group --log-group-name /platform/application-logs&#xa;aws logs create-log-group --log-group-name /platform/vpc-flow-logs&#xa;aws logs create-log-group --log-group-name /platform/waf-logs&#xa;&#xa;&#xa;# Enable VPC Flow Logs for all VPCs&#xa;for VPC_ID in $HUB_VPC $SP1_VPC $SP2_VPC $SP3_VPC; do&#xa;  aws ec2 create-flow-logs \&#xa;    --resource-type VPC --resource-ids $VPC_ID \&#xa;    --traffic-type ALL \&#xa;    --log-destination-type cloud-watch-logs \&#xa;    --log-group-name /platform/vpc-flow-logs \&#xa;    --deliver-logs-permission-arn arn:aws:iam::${ACCOUNT_ID}:role/FlowLogsRole&#xa;done&#xa;&#xa;&#xa;# Managed Grafana workspace&#xa;aws grafana create-workspace \&#xa;  --workspace-name platform-monitoring \&#xa;  --account-access-type CURRENT_ACCOUNT \&#xa;  --authentication-providers AWS_SSO \&#xa;  --permission-type SERVICE_MANAGED \&#xa;  --workspace-data-sources CLOUDWATCH XRAY PROMETHEUS" vertex="1">
          <mxGeometry height="370" width="470" x="260" y="540" as="geometry" />
        </mxCell>
        <mxCell id="hPt8dpyRI3YwL0fGorsx-2" parent="1" style="text;whiteSpace=wrap;" value="# Store all secrets&#xa;aws secretsmanager create-secret \&#xa;  --name payment/prod/db-credentials \&#xa;  --secret-string &#39;{&quot;username&quot;:&quot;paymentadmin&quot;,&quot;password&quot;:&quot;YOUR_STRONG_PASSWORD&quot;}&#39;&#xa;&#xa;&#xa;aws secretsmanager create-secret \&#xa;  --name reporting/prod/db-credentials \&#xa;  --secret-string &#39;{&quot;username&quot;:&quot;reportadmin&quot;,&quot;password&quot;:&quot;YOUR_STRONG_PASSWORD&quot;}&#39;&#xa;&#xa;&#xa;# IAM policy for EKS pods to read secrets&#xa;aws iam create-policy \&#xa;  --policy-name ReadPaymentSecrets \&#xa;  --policy-document &#39;{&#xa;    &quot;Version&quot;:&quot;2012-10-17&quot;,&#xa;    &quot;Statement&quot;:[{&#xa;      &quot;Effect&quot;:&quot;Allow&quot;,&#xa;      &quot;Action&quot;:[&quot;secretsmanager:GetSecretValue&quot;,&quot;secretsmanager:DescribeSecret&quot;],&#xa;      &quot;Resource&quot;:&quot;arn:aws:secretsmanager:&#39;${AWS_REGION}&#39;:&#39;${ACCOUNT_ID}&#39;:secret:payment/*&quot;&#xa;    }]&#xa;  }&#39;" vertex="1">
          <mxGeometry height="340" width="560" x="420" y="1020" as="geometry" />
        </mxCell>
        <UserObject label="# Customer Gateway (your on-prem router&#39;s public IP)&#xa;CGW=$(aws ec2 create-customer-gateway \&#xa;  --type ipsec.1 \&#xa;  --public-ip YOUR_ONPREM_PUBLIC_IP \&#xa;  --bgp-asn 65000 \&#xa;  --tag-specifications &#39;ResourceType=customer-gateway,Tags=[{Key=Name,Value=onprem-cgw}]&#39; \&#xa;  --query CustomerGateway.CustomerGatewayId --output text)&#xa;&#xa;&#xa;# Site-to-Site VPN attached to TGW&#xa;VPN_CONN=$(aws ec2 create-vpn-connection \&#xa;  --type ipsec.1 \&#xa;  --customer-gateway-id $CGW \&#xa;  --transit-gateway-id $TGW \&#xa;  --options StaticRoutesOnly=false \&#xa;  --tag-specifications &#39;ResourceType=vpn-connection,Tags=[{Key=Name,Value=onprem-vpn}]&#39; \&#xa;  --query VpnConnection.VpnConnectionId --output text)&#xa;&#xa;&#xa;# Download VPN config for your on-prem device&#xa;aws ec2 describe-vpn-connections \&#xa;  --vpn-connection-ids $VPN_CONN \&#xa;  --query &#39;VpnConnections[0].CustomerGatewayConfiguration&#39; \&#xa;  --output text &gt; onprem-vpn-config.xml&#xa;&#xa;&#xa;echo &quot;Configure your on-prem router using: onprem-vpn-config.xml&quot;" link="# Customer Gateway (your on-prem router&#39;s public IP)&#xa;CGW=$(aws ec2 create-customer-gateway \&#xa;  --type ipsec.1 \&#xa;  --public-ip YOUR_ONPREM_PUBLIC_IP \&#xa;  --bgp-asn 65000 \&#xa;  --tag-specifications &#39;ResourceType=customer-gateway,Tags=[{Key=Name,Value=onprem-cgw}]&#39; \&#xa;  --query CustomerGateway.CustomerGatewayId --output text)&#xa;&#xa;&#xa;# Site-to-Site VPN attached to TGW&#xa;VPN_CONN=$(aws ec2 create-vpn-connection \&#xa;  --type ipsec.1 \&#xa;  --customer-gateway-id $CGW \&#xa;  --transit-gateway-id $TGW \&#xa;  --options StaticRoutesOnly=false \&#xa;  --tag-specifications &#39;ResourceType=vpn-connection,Tags=[{Key=Name,Value=onprem-vpn}]&#39; \&#xa;  --query VpnConnection.VpnConnectionId --output text)&#xa;&#xa;&#xa;# Download VPN config for your on-prem device&#xa;aws ec2 describe-vpn-connections \&#xa;  --vpn-connection-ids $VPN_CONN \&#xa;  --query &#39;VpnConnections[0].CustomerGatewayConfiguration&#39; \&#xa;  --output text &gt; onprem-vpn-config.xml&#xa;&#xa;&#xa;echo &quot;Configure your on-prem router using: onprem-vpn-config.xml&quot;" id="hPt8dpyRI3YwL0fGorsx-3">
          <mxCell parent="1" style="text;whiteSpace=wrap;fontSize=17;" vertex="1">
            <mxGeometry height="410" width="560" x="600" y="1520" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="hPt8dpyRI3YwL0fGorsx-4" parent="1" style="text;whiteSpace=wrap;fontSize=18;" value="# WAF must be created in us-east-1 for CloudFront&#xa;aws wafv2 create-web-acl \&#xa;  --name platform-waf \&#xa;  --scope CLOUDFRONT \&#xa;  --region us-east-1 \&#xa;  --default-action Allow={} \&#xa;  --rules &#39;[&#xa;    {&#xa;      &quot;Name&quot;:&quot;CommonRuleSet&quot;,&quot;Priority&quot;:1,&#xa;      &quot;Statement&quot;:{&quot;ManagedRuleGroupStatement&quot;:{&quot;VendorName&quot;:&quot;AWS&quot;,&quot;Name&quot;:&quot;AWSManagedRulesCommonRuleSet&quot;}},&#xa;      &quot;OverrideAction&quot;:{&quot;None&quot;:{}},&#xa;      &quot;VisibilityConfig&quot;:{&quot;SampledRequestsEnabled&quot;:true,&quot;CloudWatchMetricsEnabled&quot;:true,&quot;MetricName&quot;:&quot;CommonRuleSet&quot;}&#xa;    },&#xa;    {&#xa;      &quot;Name&quot;:&quot;BotControl&quot;,&quot;Priority&quot;:2,&#xa;      &quot;Statement&quot;:{&quot;ManagedRuleGroupStatement&quot;:{&quot;VendorName&quot;:&quot;AWS&quot;,&quot;Name&quot;:&quot;AWSManagedRulesBotControlRuleSet&quot;}},&#xa;      &quot;OverrideAction&quot;:{&quot;None&quot;:{}},&#xa;      &quot;VisibilityConfig&quot;:{&quot;SampledRequestsEnabled&quot;:true,&quot;CloudWatchMetricsEnabled&quot;:true,&quot;MetricName&quot;:&quot;BotControl&quot;}&#xa;    },&#xa;    {&#xa;      &quot;Name&quot;:&quot;RateLimit&quot;,&quot;Priority&quot;:3,&#xa;      &quot;2000&quot;:{&quot;RateBasedStatement&quot;:{&quot;Limit&quot;:2000,&quot;AggregateKeyType&quot;:&quot;IP&quot;# Get the default TGW route table&#xa;TGW_RT_ID=$(aws ec2 describe-transit-gateway-route-tables \&#xa;  --filters Name=transit-gateway-id,Values=$TGW \&#xa;  --query &#39;TransitGatewayRouteTables[0].TransitGatewayRouteTableId&#39; --output text)&#xa;&#xa;# Add routes for each spoke CIDR&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 10.1.0.0/16 \&#xa;  --transit-gateway-attachment-id $SP1_ATTACH&#xa;&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 10.2.0.0/16 \&#xa;  --transit-gateway-attachment-id $SP2_ATTACH  # set SP2_ATTACH similarly&#xa;&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 10.3.0.0/16 \&#xa;  --transit-gateway-attachment-id $SP3_ATTACH  # set SP3_ATTACH similarly&#xa;&#xa;# Default route → Hub for internet egress via firewall&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 0.0.0.0/0 \  --transit-gateway-attachment-id $HUB_TGW_ATTACH}},&#xa;      &quot;Action&quot;:{&quot;Block&quot;:{}},&#xa;      &quot;VisibilityConfig&quot;:{&quot;SampledRequestsEnabled&quot;:true,&quot;CloudWatchMetricsEnabled&quot;:true,&quot;&#xa;MetricName&quot;:&quot;RateLimit&quot;}&#xa;    }&#xa;  ]&#39; \&#xa;  --visibility-config SampledRequestsEnabled=true,CloudWatchMetricsEnabled=true,MetricName=PlatformWAF&#xa;&#xa;&#xa;# ALB for Payment App&#xa;ALB_SG=$(aws ec2 create-security-group \&#xa;  --group-name payment-alb-sg --description &quot;Payment ALB SG&quot; \&#xa;  --vpc-id $SP1_VPC --query GroupId --output text)&#xa;aws ec2 authorize-security-group-ingress --group-id $ALB_SG \&#xa;  --protocol tcp --port 443 --cidr 0.0.0.0/0&#xa;&#xa;&#xa;ALB=$(aws elbv2 create-load-balancer \&#xa;  --name payment-alb \&#xa;  --subnets $SP1_PUB \&#xa;  --security-groups $ALB_SG \&#xa;  --scheme internet-facing \&#xa;  --type application \&#xa;  --query &#39;LoadBalancers[0].LoadBalancerArn&#39; --output text)" vertex="1">
          <mxGeometry height="740" width="560" x="690" y="2270" as="geometry" />
        </mxCell>
        <mxCell id="hPt8dpyRI3YwL0fGorsx-5" parent="1" style="text;whiteSpace=wrap;fontSize=16;" value="# Get the default TGW route table&#xa;TGW_RT_ID=$(aws ec2 describe-transit-gateway-route-tables \&#xa;  --filters Name=transit-gateway-id,Values=$TGW \&#xa;  --query &#39;TransitGatewayRouteTables[0].TransitGatewayRouteTableId&#39; --output text)&#xa;&#xa;&#xa;# Add routes for each spoke CIDR&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 10.1.0.0/16 \&#xa;  --transit-gateway-attachment-id $SP1_ATTACH&#xa;&#xa;&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 10.2.0.0/16 \&#xa;  --transit-gateway-attachment-id $SP2_ATTACH  # set SP2_ATTACH similarly&#xa;&#xa;&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 10.3.0.0/16 \&#xa;  --transit-gateway-attachment-id $SP3_ATTACH  # set SP3_ATTACH similarly&#xa;&#xa;&#xa;# Default route → Hub for internet egress via firewall&#xa;aws ec2 create-transit-gateway-route \&#xa;  --transit-gateway-route-table-id $TGW_RT_ID \&#xa;  --destination-cidr-block 0.0.0.0/0 \&#xa;  --transit-gateway-attachment-id $HUB_TGW_ATTACH" vertex="1">
          <mxGeometry height="460" width="480" x="910" y="4500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
