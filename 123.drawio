        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-10" parent="1" style="whiteSpace=wrap;html=1;" value="256 - 2 = 254 ( 1 ip netwrork address and broadcast address )&amp;nbsp;" vertex="1">
