        <mxCell id="jweHISguANsyJ_0BMwG7-12" parent="1" style="text;whiteSpace=wrap;" value="192        .168        .1          .10&#xa;8 bits     8 bits      8 bits      8 bits&#xa;&#xa;&#xa;8 + 8 + 8 + 8 = 32 bits" vertex="1">
