          <mxGeometry height="60" width="120" x="2507.5" y="4880" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-20" edge="1" parent="1" source="jweHISguANsyJ_0BMwG7-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="jweHISguANsyJ_0BMwG7-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-17" parent="1" style="whiteSpace=wrap;html=1;" value="255.255.255.0" vertex="1">
          <mxGeometry height="60" width="120" x="2507.5" y="5020" as="geometry" />
        </mxCell>
        <mxCell id="jweHISguANsyJ_0BMwG7-19" parent="1" style="whiteSpace=wrap;html=1;" value="255        255        255        0&#xa;11111111 . 11111111 . 11111111 . 00000000" vertex="1">
